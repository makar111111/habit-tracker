# Що НЕ копіювати в образ.
#
# Це не лише про розмір. Два перші розділи — про безпеку: образ легко
# кудись відправити (у реєстр, колезі, у CI), і все, що в нього
# потрапило, поїде разом із ним.

# Секрети. Токен бота й пароль до API в образі не мають лежати НІКОЛИ —
# вони передаються змінними оточення під час запуску.
.env

# База з особистими даними. У контейнері вона живе на змонтованому
# томі, а не всередині образу.
habits.db
habits.db*

# Віртуальне оточення: воно зібране під Windows і в Linux-контейнері
# не запрацює. Залежності ставляться заново з requirements.txt.
.venv/

# Кеші й службове — тільки місце займають.
__pycache__/
*.pyc
.pytest_cache/
.git/
.gitignore
.gitattributes

# Тести й документація в робочий образ не потрібні: контейнер запускає
# застосунок, а не перевіряє його. Тести ганяє CI на чистому клоні.
test_*.py
conftest.py
pytest.ini
requirements-dev.txt
README.md
CLAUDE.md
migrate_add_users.py

# Фронтенд: у образ їде лише ЗІБРАНИЙ результат, і збирає його окремий
# етап усередині Dockerfile.
#
# node_modules виключено з тієї ж причини, що й .venv: там лежать
# бінарні пакети під хостову систему (Windows), і в Linux-контейнері
# вони не працюють. npm ci всередині збірки поставить свої.
frontend/node_modules/
frontend/dist/
