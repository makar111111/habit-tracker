# Один образ на обидва процеси — і API, і бот.
#
# Чому один, а не два: код у них спільний (bot/api.py імпортує config,
# тести ганяють обидві частини разом), а відрізняється лише команда
# запуску. Два майже однакові Dockerfile довелося б правити парою
# щоразу — і колись забути один із них.

# Версія та сама, що й для розробки (python --version у .venv), щоб
# не ловити різницю між "у мене працює" і "на сервері падає".
# slim замість повного образу: без документації й зайвих інструментів,
# приблизно вп'ятеро менший, а для запуску Python цього досить.
FROM python:3.14-slim

# PYTHONUNBUFFERED — щоб логи йшли в docker logs одразу, а не лежали
# в буфері до його заповнення. Без цього здається, що контейнер мовчить.
# PYTHONDONTWRITEBYTECODE — .pyc у контейнері нікому не потрібні:
# він одноразовий, а файли лише засмічують шар.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Залежності — ОКРЕМИМ кроком перед копіюванням коду. Docker кешує кожен
# крок і перевикористовує, поки не змінилися його вхідні дані. Оскільки
# requirements.txt змінюється рідко, а код — щодня, при такому порядку
# перезбирання після правки коду не перевстановлює пакети заново.
# Якби COPY . . стояв першим, кеш злітав би на кожну зміну будь-якого файлу.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Свій користувач замість root. Якщо в застосунку колись знайдуть діру,
# зловмисник опиниться в контейнері без права щось у ньому міняти —
# це не панацея, але прибирає найлегший шлях далі.
#
# Теку для бази створюємо й віддаємо йому ДО переходу: змонтований том
# успадкує власника, і застосунок зможе туди писати.
RUN useradd --create-home --shell /bin/bash app \
    && mkdir -p /data \
    && chown -R app:app /app /data
USER app

# Команда за замовчуванням — API. Бот запускається тим самим образом,
# але з іншою командою (див. docker-compose.yml).
#
# host 0.0.0.0, а не 127.0.0.1: усередині контейнера "тільки локально"
# означало б, що сервер недосяжний навіть для сусіднього контейнера.
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
