# Один образ на обидва процеси — і API, і бот.
#
# Чому один, а не два: код у них спільний (bot/api.py імпортує config,
# тести ганяють обидві частини разом), а відрізняється лише команда
# запуску. Два майже однакові Dockerfile довелося б правити парою
# щоразу — і колись забути один із них.

# ---------- Етап 1: збірка фронтенду ----------
#
# Це "багатоетапна збірка" (multi-stage build). Ідея: інструменти,
# потрібні ЩОБ ЗІБРАТИ, і те, що потрібно ЩОБ ЗАПУСТИТИ, — різні речі.
# Node з усіма npm-пакетами важить близько 400 МБ, а результат його
# роботи — три файли на 300 КБ. У підсумковий образ поїдуть лише вони:
# усе інше лишиться на цьому етапі й буде викинуто.
#
# Заразом це прибирає цілий клас проблем із безпекою: у бойовому образі
# немає ні npm, ні вихідного коду фронтенду, ні сотень пакетів, у яких
# завтра знайдуть чергову вразливість.
FROM node:22-slim AS frontend

WORKDIR /build

# Спершу лише маніфести — тією ж логікою, що й з requirements.txt нижче:
# залежності міняються рідко, код щодня, і при такому порядку правка
# компонента не тягне за собою перевстановлення 200 пакетів.
COPY frontend/package.json frontend/package-lock.json ./

# npm ci, а не npm install. Різниця принципова: ci ставить РІВНО те,
# що записано в package-lock.json, і падає, якщо lock розійшовся з
# package.json. install же має право оновити lock — тобто зібрати
# зовсім не ті версії, які перевіряли тестами.
RUN npm ci

COPY frontend/ ./
RUN npm run build


# ---------- Етап 2: застосунок ----------
#
# Версія та сама, що й для розробки (python --version у .venv), щоб
# не ловити різницю між "у мене працює" і "на сервері падає".
# slim замість повного образу: без документації й зайвих інструментів,
# приблизно вп'ятеро менший, а для запуску Python цього досить.
FROM python:3.14-slim

# PYTHONUNBUFFERED — щоб логи йшли в docker logs одразу, а не лежали
# в буфері до його заповнення. Без цього здається, що контейнер мовчить.
# PYTHONDONTWRITEBYTECODE — .pyc у контейнері нікому не потрібні:
# він одноразовий, а файли лише засмічують шар.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHON_DOTENV_DISABLED=1

WORKDIR /app

# Залежності — ОКРЕМИМ кроком перед копіюванням коду. Docker кешує кожен
# крок і перевикористовує, поки не змінилися його вхідні дані. Оскільки
# requirements.txt змінюється рідко, а код — щодня, при такому порядку
# перезбирання після правки коду не перевстановлює пакети заново.
# Якби COPY . . стояв першим, кеш злітав би на кожну зміну будь-якого файлу.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Забираємо з першого етапу лише результат збірки. `--from=frontend`
# посилається на етап за іменем, яке ми дали йому через AS.
# Шлях призначення той самий, куди дивиться FRONTEND_DIR у main.py.
COPY --from=frontend /build/dist ./frontend/dist

# Свій користувач замість root. Якщо в застосунку колись знайдуть діру,
# зловмисник опиниться в контейнері без права щось у ньому міняти —
# це не панацея, але прибирає найлегший шлях далі.
#
# Теку для бази створюємо й віддаємо йому ДО переходу: змонтований том
# успадкує власника, і застосунок зможе туди писати.
RUN useradd --create-home --shell /bin/bash app \
    && mkdir -p /data/backups \
    && chown -R app:app /app /data
USER app

EXPOSE 8000

# Команда за замовчуванням — API. Бот запускається тим самим образом,
# але з іншою командою (див. docker-compose.yml).
#
# host 0.0.0.0, а не 127.0.0.1: усередині контейнера "тільки локально"
# означало б, що сервер недосяжний навіть для сусіднього контейнера.
#
# --proxy-headers: за reverse proxy адреса з'єднання — це адреса проксі,
# а не відвідувача. Без справжньої IP ліміт спроб входу (rate_limit.py)
# був би один на всіх, і будь-хто міг би закрити вхід усім. Кому саме
# довіряти заголовок X-Forwarded-For, uvicorn бере зі змінної
# FORWARDED_ALLOW_IPS — її задає docker-compose.yml.
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
