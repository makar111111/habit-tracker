# Віртуальне оточення — у кожного своє, важить сотні мегабайт.
# Відтворюється з requirements.txt однією командою.
.venv/

# Скомпільовані Python-файли, створюються автоматично.
__pycache__/
*.pyc

# База даних. НАЙВАЖЛИВІШИЙ рядок: тут особисті дані,
# і в репозиторії їм не місце. Схема таблиць живе в models.py,
# тож база відтвориться сама при першому запуску.
#
# habits.db* (зірка ПІСЛЯ .db), а не просто *.db: резервні копії на
# кшталт habits.db.backup чи habits.db.before-cleanup закінчуються не
# на .db, і просте *.db їх не ловить. Саме такі копії лежали в цій
# теці непідконтрольні git, поки цей рядок не виправили.
habits.db*

# Кеш pytest.
.pytest_cache/

# Секрети: токен бота, паролі, ключі. У репозиторій НІКОЛИ.
# Витік токена = чужа людина керує твоїм ботом. Боти-сканери
# знаходять такі ключі на GitHub за лічені хвилини після коміту.
# Зразок без справжніх значень лежить у .env.example — він комітиться.
.env
