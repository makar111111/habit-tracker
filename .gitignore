# Віртуальне оточення — у кожного своє, важить сотні мегабайт.
# Відтворюється з requirements.txt однією командою.
.venv/

# Скомпільовані Python-файли, створюються автоматично.
__pycache__/
*.pyc

# База даних. НАЙВАЖЛИВІШИЙ рядок: тут особисті дані,
# і в репозиторії їм не місце. Схема таблиць живе в models.py,
# тож база відтвориться сама при першому запуску.
*.db

# Кеш pytest.
.pytest_cache/
