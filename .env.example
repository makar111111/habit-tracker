# Зразок налаштувань. Скопіюй цей файл у .env і встав справжні значення.
#
#   Git Bash:    cp .env.example .env
#   PowerShell:  Copy-Item .env.example .env
#
# Сам .env у git не потрапляє — про це подбав .gitignore.


# Спільний пароль між ботом і API.
#
# Навіщо: API повинен якось відрізнити "це прийшов мій бот і каже,
# що обслуговує користувача 12345" від "це хтось сторонній вирішив
# назватися користувачем 12345". Бот додає цей рядок до кожного запиту,
# API звіряє. Не збігається — 401 і жодних даних.
#
# Згенерувати випадковий:  python -c "import secrets; print(secrets.token_hex(32))"
BOT_SECRET=

# Токен від @BotFather. Знадобиться на кроці 2, поки можна лишити порожнім.
BOT_TOKEN=

# Адреса, за якою бот шукатиме API.
API_URL=http://127.0.0.1:8000
