# Зразок налаштувань. Скопіюй цей файл у .env і встав справжні значення.
#
#   Git Bash:    cp .env.example .env
#   PowerShell:  Copy-Item .env.example .env
#
# Сам .env у git не потрапляє — про це подбав .gitignore.


# Спільний пароль між ботом і API.
#
# Навіщо: API повинен якось відрізнити "це прийшов мій бот і каже,
# що обслуговує користувача 12345" від "це хтось сторонній вирішив
# назватися користувачем 12345". Бот додає цей рядок до кожного запиту,
# API звіряє. Не збігається — 401 і жодних даних.
#
# Згенерувати випадковий:  python -c "import secrets; print(secrets.token_hex(32))"
BOT_SECRET=

# Токен від @BotFather.
BOT_TOKEN=

# Адреса, за якою бот шукатиме API.
API_URL=http://127.0.0.1:8000

# О котрій годині (за годинником машини, де працює бот) надсилати щоденне
# нагадування про невідмічені звички. Необов'язково — за замовчуванням 20.
REMINDER_HOUR=20

# --- Далі те, що потрібно лише для запуску в Docker ---

# Часовий пояс контейнерів. За замовчуванням усередині Docker — UTC,
# і тоді "20:00" перетворилося б на 23:00 за Києвом. Задається ОБОМ
# контейнерам однаково: бот і API кожен рахує "сьогодні" за своїм
# годинником, і розбіжність між ними означала б, що вечірня відмітка
# лягає на "завтра" з погляду одного з них.
TZ=Europe/Kyiv

# Де лежить база. Поза Docker лишається порожнім — тоді це habits.db
# у теці проєкту. У docker-compose.yml задано sqlite:////data/habits.db
# (чотири слеші = абсолютний шлях) на змонтованому томі.
DATABASE_URL=

# --- Вхід у вебверсію через бота ---

# Ім'я бота без @ — з нього збирається посилання t.me/ІМ'Я?start=КОД.
BOT_USERNAME=

# Чим підписуються cookie сесій. Порожньо = вхід у веб вимкнено.
# Змінити цей рядок = миттєво відкликати всі видані сесії.
# Згенерувати:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Дозволити запит БЕЗ автентифікації вважати «локальним користувачем».
# Зручно для розробки, НЕБЕЗПЕЧНО на сервері. За замовчуванням вимкнено.
ALLOW_LOCAL_USER=
