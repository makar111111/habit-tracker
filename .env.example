# Скопіюй у .env лише при першому налаштуванні, якщо .env ще немає.
# PowerShell: Copy-Item .env.example .env
# Git Bash: cp .env.example .env
# Справжній .env не входить у Git або Docker-образ.

# --- Обов'язкові для бота й вебвходу ---

# Токен від @BotFather.
BOT_TOKEN=

# Спільний ASCII-секрет бота й API для X-Bot-Secret.
# Згенерувати: python -c "import secrets; print(secrets.token_hex(32))"
BOT_SECRET=

# Ім'я бота без @; використовується в посиланні входу через Telegram.
BOT_USERNAME=

# Окремий секрет підпису сесій. Зміна відкликає всі видані cookie.
# Згенеруй незалежно від BOT_SECRET тією самою командою вище.
SESSION_SECRET=

# false для локального HTTP; true при публікації вебзастосунку через HTTPS.
SESSION_COOKIE_SECURE=false

# --- Розміщення ---

# Кому API довіряє заголовок X-Forwarded-For (reverse proxy). Порожньо =
# Compose бере 172.16.0.0/12 — шлюз мережі Docker. Якщо Docker видав мережу
# з 192.168.x.x, впиши її. Ніколи не став "*": ліміт входу стане обхідним.
FORWARDED_ALLOW_IPS=

# Скільки кодів входу одна IP може попросити за вікно (секунди).
LOGIN_CODE_RATE_LIMIT=10
LOGIN_CODE_RATE_WINDOW_SECONDS=60

# Адреса API для локального бота. Compose сам задає http://api:8000.
API_URL=http://127.0.0.1:8000

# Порожньо = sqlite:///habits.db. Для окремих даних задай явний SQLite URL.
# Compose використовує sqlite:////data/habits.db на іменованому томі.
DATABASE_URL=

# Щоденні узгоджені SQLite-копії (одна на UTC-день).
# Порожньо = вимкнено поза Compose; Compose задає /data/backups.
# Передміграційна копія створюється незалежно від цієї змінної.
BACKUP_DIR=

# Пояс системних логів контейнерів. Особистий пояс і годину нагадувань
# змінюй у профілі: стандартно Europe/Kyiv, 20:00, нагадування ввімкнені.
TZ=Europe/Kyiv

# Сумісність зі старим планувальником. Особистий reminder_hour у БД
# має пріоритет; нові акаунти й міграція використовують 20.
REMINDER_HOUR=20

# --- Лише локальна розробка ---

# 1 = доступ до окремого локального акаунта без автентифікації.
# За замовчуванням вимкнено. Compose завжди передає false.
ALLOW_LOCAL_USER=
